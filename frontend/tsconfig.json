{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "isolatedModules": true, "verbatimModuleSyntax": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
