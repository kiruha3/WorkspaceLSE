digraph ais {
graph [layout=fdp,overlap=prism,sep="+14",K=0.4,start=42,maxiter=1000];
graph [rankdir=LR, bgcolor="#fbfcfa", fontname="Arial", fontsize=24, label="ФГБУ Абаканская ЛСЭ — фактическая схема PostgreSQL\n71 таблица · 151 внешний ключ · 28.10.2026\nPK — первичный ключ; FK — внешний; U — уникальный. Круг — связь необязательна; вилка — много. N:M — через связующие таблицы.\nОтдел в номере и текущая ответственность: разделение ещё НЕ внедрено.",labelloc=t, nodesep=0.38,ranksep=1.05,splines=polyline,compound=true,pad=0.45];
node [shape=plain,fontname="Arial",fontsize=11];
edge [dir=both,arrowsize=0.65,color="#879b90",fontname="Arial",fontsize=9,fontcolor="#3d5f4c",penwidth=0.8];
